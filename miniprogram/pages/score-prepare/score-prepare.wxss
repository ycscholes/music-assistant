.prepare-page,
.hero,
.tips,
.score-panel,
.prep-note {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.prepare-page {
  gap: 24rpx;
}

.eyebrow {
  color: var(--warning);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.title,
.section-title {
  color: var(--primary);
  font-family: "Songti SC", "STSong", Georgia, serif;
  font-size: 42rpx;
  font-weight: 800;
}

.subtitle,
.tip,
.stat-label {
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.45;
}

.stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  padding: 0;
  background: transparent;
  border-top: 1rpx solid var(--line);
  border-left: none;
  border-right: none;
}

.stat-item {
  border: none;
  border-bottom: 1rpx solid var(--line);
  padding: 18rpx 0;
}

.stat-value {
  display: block;
  color: var(--primary);
  font-family: Georgia, "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 800;
}

.stat-label {
  display: block;
}

.tips,
.score-panel {
  background: transparent;
  border-left: none;
  border-right: none;
}

.empty-state {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.prep-note {
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.45;
  padding: 0 0 12rpx;
  border-bottom: 1rpx solid var(--line);
}
