.settings-page {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.settings-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.setting-label {
  color: var(--primary);
  font-size: 30rpx;
  font-weight: 700;
}

.setting-toggle {
  position: relative;
  width: 78rpx;
  height: 38rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  background: rgba(245, 239, 227, 0.72);
}

.setting-toggle.active {
  background: var(--primary);
}

.setting-toggle-dot {
  position: absolute;
  left: 4rpx;
  top: 4rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: var(--primary);
  transition: transform 180ms ease-out;
}

.setting-toggle.active .setting-toggle-dot {
  background: var(--ivory);
  transform: translateX(40rpx);
}

.setting-hint {
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.5;
}
