.history-page,
.record-list,
.state,
.header {
  display: flex;
  flex-direction: column;
}

.history-page {
  gap: 34rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.header {
  gap: 14rpx;
  padding: 36rpx 0 24rpx;
  border-bottom: 1rpx solid var(--line);
}

.title {
  color: var(--primary);
  font-family: "Songti SC", "STSong", Georgia, serif;
  font-size: 54rpx;
  font-weight: 800;
}

.subtitle,
.record-meta,
.record-label {
  color: var(--muted);
  font-size: 24rpx;
}

.state {
  gap: 20rpx;
  color: var(--muted);
  line-height: 1.5;
  background: transparent;
}

.error {
  color: var(--danger);
}

.record-list {
  gap: 0;
  border-top: 1rpx solid var(--line);
}

.record {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  padding: 26rpx 0 26rpx 18rpx;
  border: none;
  border-bottom: 1rpx solid var(--line);
  border-left: 6rpx solid transparent;
  background: transparent;
}

.record.record-basic {
  border-left-color: var(--accent);
}

.record.record-score-practice {
  border-left-color: var(--success);
}

.record-badge {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

.badge-basic {
  color: var(--accent);
  background: rgba(154, 77, 56, 0.08);
}

.badge-score {
  color: var(--success);
  background: rgba(94, 111, 78, 0.08);
}

.record-score {
  color: var(--accent);
  font-family: Georgia, "Songti SC", serif;
  font-size: 58rpx;
  font-weight: 800;
}

.record-meta {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
}
