.score-result-page,
.score-grid,
.actions,
.issue-list,
.empty-state,
.result-hero,
.score-seal,
.advice-panel,
.issue-panel {
  display: flex;
  flex-direction: column;
}

.score-result-page,
.actions,
.issue-list,
.empty-state {
  gap: 24rpx;
}

.score-result-page {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.result-hero {
  gap: 28rpx;
  padding: 34rpx 0 30rpx;
  border-top: 1.5rpx solid var(--primary);
  border-bottom: 1.5rpx solid var(--primary);
}

.eyebrow {
  display: block;
  color: var(--warning);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.title,
.section-title {
  display: block;
  color: var(--primary);
  font-family: "Songti SC", "STSong", Georgia, serif;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.22;
}

.subtitle,
.item-label,
.body-copy,
.issue-item {
  color: var(--muted);
  font-size: 25rpx;
  line-height: 1.55;
}

.score-seal {
  align-self: center;
  align-items: center;
  justify-content: center;
  width: 210rpx;
  height: 210rpx;
  border: 2rpx solid rgba(154, 77, 56, 0.72);
  border-radius: 999rpx;
  background: rgba(245, 239, 227, 0.74);
}

.score {
  display: block;
  color: var(--accent);
  font-family: Georgia, "Songti SC", serif;
  font-size: 86rpx;
  font-weight: 800;
  line-height: 1;
}

.score-label {
  display: block;
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 800;
}

.score-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  padding: 0;
  background: transparent;
  border-left: none;
  border-right: none;
}

.score-item {
  border-bottom: 1rpx solid var(--line);
  padding: 22rpx 0;
  text-align: center;
}

.score-value {
  display: block;
  color: var(--primary);
  font-family: Georgia, "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 800;
}

.advice-panel,
.issue-panel,
.score-result-page > .panel {
  gap: 14rpx;
  background: transparent;
  border-left: none;
  border-right: none;
  padding-left: 0;
  padding-right: 0;
}

.issue-item {
  display: block;
  padding: 12rpx 0 12rpx 18rpx;
  border-left: 5rpx solid var(--accent);
  border-bottom: 1rpx solid rgba(216, 208, 192, 0.72);
}

.score-result-page > .actions {
  align-items: center;
  gap: 14rpx;
  padding-top: 6rpx;
}

.score-result-page > .actions .primary-button,
.score-result-page > .actions .secondary-button,
.empty-state .primary-button {
  width: 100%;
  max-width: 520rpx;
}

.actions .secondary-button {
  border: 1.5rpx solid rgba(23, 22, 20, 0.24);
}

@media (max-width: 360px) {
  .score-seal {
    width: 184rpx;
    height: 184rpx;
  }

  .score {
    font-size: 74rpx;
  }
}
