.result-page {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.score-panel {
  padding: 44rpx 0 36rpx;
  border-top: 1rpx solid var(--primary);
  border-bottom: 1rpx solid var(--primary);
  color: var(--primary);
}

.score {
  display: block;
  font-family: "Songti SC", "STSong", Georgia, serif;
  font-size: 104rpx;
  font-weight: 800;
  line-height: 1;
  text-align: center;
}

.score-label {
  display: block;
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 24rpx;
  text-align: center;
}

.result-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  padding: 0;
  background: transparent;
  border-left: none;
  border-right: none;
}

.result-item {
  border: none;
  border-bottom: 1rpx solid var(--line);
  padding: 22rpx 8rpx;
}

.result-item.full {
  grid-column: span 2;
}

.result-value {
  display: block;
  font-family: Georgia, "Songti SC", serif;
  color: var(--accent);
  font-size: 38rpx;
  font-weight: 800;
}

.result-label {
  display: block;
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.advice {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  border-left: 6rpx solid var(--accent);
}

.playback {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  background: transparent;
}

.playback-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.advice-title,
.playback-title,
.empty-title {
  color: var(--primary);
  font-family: "Songti SC", "STSong", Georgia, serif;
  font-size: 34rpx;
  font-weight: 800;
}

.advice-text,
.playback-text,
.empty-text {
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.6;
}

.playback-button {
  width: 100%;
}

.actions,
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.actions .primary-button,
.actions .secondary-button,
.empty .primary-button {
  width: 100%;
  max-width: 520rpx;
}

.actions .secondary-button {
  border: 1.5rpx solid rgba(23, 22, 20, 0.24);
}

@media (max-width: 360px) {
  .score {
    font-size: 88rpx;
  }
}
