.practice-page,
.practice-top,
.piece-copy,
.score-strip,
.state-card,
.score-head,
.signal-row,
.piece-meta-row,
.action-copy,
.control-block-head,
.start-panel,
.start-copy {
  display: flex;
}

.practice-page {
  box-sizing: border-box;
  flex-direction: column;
  min-height: 100vh;
  width: 100vw;
  padding: 14rpx 0 0;
  gap: 10rpx;
  overflow: hidden;
}

.piece-copy,
.score-strip,
.state-card {
  flex-direction: column;
}

.practice-top {
  flex-shrink: 0;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 0 26rpx 8rpx;
  width: 100%;
  box-sizing: border-box;
  border-bottom: 1rpx solid rgba(216, 208, 192, 0.72);
}

.piece-copy {
  flex: 1;
  min-width: 0;
  gap: 8rpx;
}

.eyebrow-row,
.piece-meta-row {
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.eyebrow {
  color: var(--warning);
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.mode-badge {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  color: var(--muted);
  font-size: 18rpx;
  font-weight: 800;
  background: rgba(245, 239, 227, 0.62);
}

.mode-badge.follow-active {
  color: var(--success);
  border-color: rgba(94, 111, 78, 0.72);
  background: rgba(94, 111, 78, 0.08);
}

.mode-badge.gate-active {
  color: var(--accent);
  border-color: rgba(154, 77, 56, 0.72);
  background: rgba(154, 77, 56, 0.08);
}

.title {
  color: var(--primary);
  font-family: "Songti SC", "STSong", Georgia, serif;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.18;
}

.piece-meta-row text {
  padding: 4rpx 12rpx;
  border: 1rpx solid rgba(23, 22, 20, 0.12);
  border-radius: 999rpx;
  color: var(--muted);
  font-size: 19rpx;
  font-weight: 700;
  background: rgba(251, 250, 244, 0.72);
}

.focus-tip,
.phase-copy,
.detected-pitch,
.range-copy,
.action-hint {
  color: var(--muted);
  font-size: 20rpx;
  line-height: 1.35;
}

.focus-tip {
  display: block;
  max-height: 58rpx;
  overflow: hidden;
}

.beat-pill {
  flex-shrink: 0;
  min-width: 120rpx;
  border-top: 2rpx solid var(--primary);
  border-bottom: 2rpx solid var(--primary);
  padding: 8rpx 0;
  text-align: right;
}

.beat-pill.pulse {
  animation: beatPulse 150ms ease-out;
}

@keyframes beatPulse {
  0% { transform: scale(1.12); opacity: 0.7; }
  100% { transform: scale(1); opacity: 1; }
}

.meter-label {
  display: block;
  font-size: 18rpx;
  color: var(--warning);
}

.meter-value {
  display: block;
  font-family: "Songti SC", "STSong", Georgia, serif;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.1;
}

.score-strip {
  flex: 1;
  min-height: 0;
  gap: 6rpx;
  width: 100%;
  box-sizing: border-box;
}

.score-head,
.signal-row {
  flex-shrink: 0;
  align-items: flex-end;
  justify-content: space-between;
  gap: 14rpx;
  padding: 0 22rpx;
}

.score-head view {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.section-title {
  color: var(--primary);
  font-family: "Songti SC", "STSong", Georgia, serif;
  font-size: 22rpx;
  font-weight: 800;
}

.target-note,
.detected-note,
.progress {
  color: var(--accent);
  font-family: Georgia, "Songti SC", serif;
  font-size: 25rpx;
  font-weight: 800;
}

.detected-note {
  color: var(--primary);
  font-size: 22rpx;
}

.progress {
  white-space: nowrap;
}

.formal-score-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
}

.formal-score-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 4rpx 0 calc(336rpx + env(safe-area-inset-bottom));
  width: 100%;
  box-sizing: border-box;
}

.practice-page.running .formal-score-list {
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
}

.formal-score-stage {
  position: relative;
  flex: none;
  width: 100%;
  min-height: 188rpx;
  overflow: visible;
  background: #fffaf1;
  border-top: 2rpx solid rgba(62, 47, 37, 0.12);
  border-bottom: 2rpx solid rgba(62, 47, 37, 0.12);
}

.formal-score-stage.active-system {
  border-top-color: rgba(177, 74, 43, 0.34);
  border-bottom-color: rgba(177, 74, 43, 0.34);
}

.formal-score-image {
  display: block;
  width: 100%;
}

.active-note-marker {
  position: absolute;
  box-sizing: border-box;
  z-index: 8;
  pointer-events: none;
  overflow: visible;
}

.active-note-playhead {
  position: absolute;
  left: 50%;
  top: -28%;
  width: 7rpx;
  min-width: 5rpx;
  height: 156%;
  min-height: 88rpx;
  border-radius: 999rpx;
  background: #D8261C;
  box-shadow:
    0 0 0 6rpx rgba(216, 38, 28, 0.12),
    0 0 18rpx rgba(216, 38, 28, 0.38);
  transform: translateX(-50%);
}

.range-note-box {
  position: absolute;
  z-index: 4;
  box-sizing: border-box;
  border-radius: 999rpx;
}

.range-note-box.selectable {
  background: rgba(177, 74, 43, 0.05);
}

.range-note-box.selected {
  border: 3rpx solid rgba(177, 74, 43, 0.52);
  background: rgba(237, 166, 64, 0.16);
}

.range-note-box.range-start,
.range-note-box.range-end {
  border-color: rgba(177, 74, 43, 0.92);
  box-shadow: 0 0 0 7rpx rgba(177, 74, 43, 0.1);
}

.score-component {
  flex: none;
  height: calc(100vh - 336rpx);
  min-height: 0;
  display: flex;
  overflow: hidden;
}

.practice-page.running .score-component {
  height: calc(100vh - 252rpx);
}

.compact-score {
  height: calc(100vh - 318rpx);
}

.practice-page.running .compact-score {
  height: calc(100vh - 228rpx);
}

.signal-row {
  padding-bottom: calc(336rpx + env(safe-area-inset-bottom));
}

.practice-page.running .signal-row {
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
}

.practice-actions {
  position: fixed;
  right: 24rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  z-index: 100;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 18rpx 20rpx 18rpx;
  border: 1rpx solid rgba(216, 208, 192, 0.88);
  border-radius: 26rpx;
  background: rgba(251, 250, 244, 0.98);
  box-shadow: 0 -16rpx 40rpx rgba(62, 47, 37, 0.1);
}

.action-deck-head,
.range-tools,
.prep-tools {
  display: flex;
}

.action-deck-head {
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.action-copy {
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 4rpx;
}

.action-label {
  color: var(--warning);
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.action-title {
  display: block;
  color: var(--primary);
  font-family: "Songti SC", "STSong", Georgia, serif;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.15;
}

.action-range-chip {
  flex-shrink: 0;
  min-width: 142rpx;
  padding: 8rpx 12rpx;
  border: 1rpx solid rgba(23, 22, 20, 0.1);
  border-radius: 18rpx;
  background: rgba(245, 239, 227, 0.78);
  text-align: right;
}

.action-range-chip.partial {
  border-color: rgba(154, 77, 56, 0.32);
  background: rgba(154, 77, 56, 0.08);
}

.action-range-chip.selecting {
  border-color: rgba(146, 118, 74, 0.4);
  background: rgba(146, 118, 74, 0.09);
}

.action-range-chip-label,
.action-range-chip-value {
  display: block;
}

.action-range-chip-label {
  color: var(--muted);
  font-size: 17rpx;
  line-height: 1.2;
}

.action-range-chip-value {
  margin-top: 4rpx;
  color: var(--primary);
  font-family: "Songti SC", "STSong", Georgia, serif;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.15;
}

.mode-section,
.range-panel,
.start-panel {
  border: 1rpx solid rgba(23, 22, 20, 0.09);
  background: rgba(245, 239, 227, 0.56);
}

.mode-section,
.range-panel,
.start-panel,
.control-block {
  border-radius: 20rpx;
}

.control-block-title,
.start-label {
  color: var(--warning);
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.action-guidance-copy,
.control-footnote,
.start-caption,
.control-block-meta {
  color: var(--muted);
  font-size: 19rpx;
  line-height: 1.35;
}

.mode-section,
.range-panel {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 12rpx 14rpx 14rpx;
}

.control-block-head {
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.mode-switch {
  display: flex;
  gap: 8rpx;
}

.mode-option {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 3rpx;
  padding: 10rpx 10rpx;
  min-height: 76rpx;
  border: 1rpx solid rgba(23, 22, 20, 0.14);
  border-radius: 16rpx;
  background: rgba(251, 250, 244, 0.92);
  color: var(--muted);
  text-align: center;
}

.mode-option.active {
  background: var(--primary);
  color: var(--ivory);
  border-color: var(--primary);
  box-shadow: 0 8rpx 16rpx rgba(23, 22, 20, 0.14);
}

.mode-option.active.follow {
  background: var(--success);
  border-color: var(--success);
}

.mode-option.active.gate {
  background: var(--accent);
  border-color: var(--accent);
}

.mode-option-title,
.mode-option-desc {
  display: block;
}

.mode-option-title {
  color: currentColor;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.15;
}

.mode-option-desc {
  color: rgba(117, 109, 97, 0.9);
  font-size: 17rpx;
  line-height: 1.2;
}

.mode-option.active .mode-option-desc,
.mode-option.active.follow .mode-option-desc,
.mode-option.active.gate .mode-option-desc {
  color: rgba(251, 250, 244, 0.78);
}

.range-tools {
  gap: 8rpx;
}

.prep-tools {
  align-items: stretch;
  gap: 12rpx;
}

.range-panel {
  flex: 1;
  min-width: 0;
}

.practice-actions .primary-button,
.practice-actions .secondary-button {
  position: static;
  right: auto;
  bottom: auto;
  left: auto;
  width: 100%;
  max-width: none;
  margin: 0;
  min-height: 66rpx;
  padding: 0 20rpx;
  line-height: 66rpx;
  font-size: 24rpx;
}

.range-button {
  flex: 1;
}

.range-button.selecting {
  border-color: rgba(146, 118, 74, 0.36);
  background: rgba(146, 118, 74, 0.08);
}

.practice-actions .range-reset {
  flex: none;
  width: 164rpx;
  padding: 0 10rpx;
}

.control-footnote {
  display: block;
}

.start-panel {
  flex: 0 0 280rpx;
  min-width: 280rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 12rpx;
  text-align: center;
}

.start-panel.is-pending {
  border-color: rgba(146, 118, 74, 0.32);
  background: rgba(146, 118, 74, 0.09);
}

.start-copy {
  flex: none;
  min-width: 0;
  flex-direction: column;
  gap: 4rpx;
  width: 100%;
}

.start-button {
  width: 100% !important;
  max-width: 520rpx;
  min-width: 0;
  min-height: 72rpx;
  line-height: 72rpx;
  font-size: 25rpx;
}

.start-button.waiting-range {
  background: var(--warning);
  color: var(--background);
}

.start-button[disabled] {
  background: rgba(146, 118, 74, 0.72);
  color: rgba(251, 250, 244, 0.82);
}

.danger-outline {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  width: auto;
  max-width: none;
  min-height: 68rpx;
  margin: 0 32rpx;
  margin-bottom: calc(24rpx + env(safe-area-inset-bottom));
  padding: 0 28rpx;
  background: var(--ivory);
  color: var(--danger);
  border: 1.5rpx solid rgba(184, 80, 66, 0.5);
  border-radius: 999rpx;
  font-size: 25rpx;
  line-height: 68rpx;
}

.score-strip,
.state-card {
  background: transparent;
  border-left: none;
  border-right: none;
}
