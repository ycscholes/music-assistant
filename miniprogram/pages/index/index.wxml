<view class="page home-page">
  <view class="hero">
    <text class="eyebrow">Silent practice instrument</text>
    <text class="title">小提琴智能陪练</text>
    <view class="title-rule"></view>
    <text class="subtitle">先听见稳定长弓，再校准每一个音。</text>
  </view>

  <view class="practice-console">
    <view class="target-block">
      <text class="target-label">今日建议</text>
      <text class="target-value">G D A E</text>
      <text class="target-copy">空弦 · 长音 · 保持 4 秒</text>
    </view>

    <button class="primary-button start-button" bindtap="startPractice">开始练习</button>

    <view class="status-strip">
      <text>本地识别</text>
      <text>不上传原始音频</text>
    </view>
  </view>

  <view class="secondary-nav">
    <view class="nav-row" hover-class="nav-row-active" bindtap="openScorePractice">
      <text class="nav-title">曲谱评测</text>
      <text class="nav-meta">固定 BPM 短句练习</text>
    </view>
    <view class="nav-row" hover-class="nav-row-active" bindtap="openHistory">
      <text class="nav-title">练习记录</text>
      <text class="nav-meta">查看评分与偏差</text>
    </view>
    <view class="nav-row" hover-class="nav-row-active" bindtap="openMetronome">
      <text class="nav-title">节拍器</text>
      <text class="nav-meta">自由速度 · 视觉拍点</text>
    </view>
    <view class="nav-row" hover-class="nav-row-active" bindtap="openSettings">
      <text class="nav-title">设置</text>
      <text class="nav-meta">动画与偏好</text>
    </view>
  </view>
</view>
