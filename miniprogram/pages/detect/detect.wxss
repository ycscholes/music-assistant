.detect-page {
  height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 26rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  color: var(--ink);
  overflow-y: auto;
}

.frequency-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  flex: 0 0 auto;
}

.frequency-text {
  color: var(--muted);
  font-size: 22rpx;
  font-family: Georgia, "Songti SC", serif;
}

.frequency-text.active {
  color: var(--primary);
}

.frequency-toggle {
  position: relative;
  width: 78rpx;
  height: 38rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  background: rgba(245, 239, 227, 0.72);
}

.toggle-dot {
  position: absolute;
  left: 4rpx;
  top: 4rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: var(--primary);
  transition: transform 180ms ease-out;
}

.frequency-toggle.active .toggle-dot {
  transform: translateX(40rpx);
}

.readout-panel {
  margin-top: 24rpx;
  padding: 26rpx 0 20rpx;
  border-top: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
  text-align: center;
  flex: 0 0 auto;
}

.readout-label {
  display: block;
  color: var(--warning);
  font-size: 20rpx;
  font-weight: 700;
}

.readout-note {
  display: block;
  margin-top: 6rpx;
  color: var(--primary);
  font-family: "Songti SC", "STSong", Georgia, serif;
  font-size: 112rpx;
  font-weight: 800;
  line-height: 0.95;
}

.readout-cent {
  display: block;
  margin-top: 10rpx;
  color: var(--accent);
  font-family: Georgia, "Songti SC", serif;
  font-size: 42rpx;
  font-weight: 700;
}

.reference-scale {
  position: relative;
  width: 74vw;
  max-width: 560rpx;
  height: 84rpx;
  margin: 22rpx auto 0;
}

.scale-tune-zone {
  position: absolute;
  left: 50%;
  top: 0;
  width: 25%;
  height: 100%;
  transform: translateX(-50%);
  background: linear-gradient(90deg,
    rgba(94, 111, 78, 0) 0%,
    rgba(94, 111, 78, 0.10) 30%,
    rgba(94, 111, 78, 0.14) 50%,
    rgba(94, 111, 78, 0.10) 70%,
    rgba(94, 111, 78, 0) 100%
  );
  border-radius: 4rpx;
  pointer-events: none;
}

.scale-line {
  position: absolute;
  left: 0;
  right: 0;
  top: 28rpx;
  height: 1rpx;
  background: var(--primary);
}

.scale-line::before,
.scale-line::after {
  content: "";
  position: absolute;
  top: -9rpx;
  width: 1rpx;
  height: 19rpx;
  background: var(--line);
}

.scale-line::before {
  left: 18%;
}

.scale-line::after {
  right: 18%;
}

.scale-needle {
  position: absolute;
  left: 50%;
  top: 4rpx;
  width: 3rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: var(--accent);
  transform: translateX(-50%);
  transition: left 120ms ease-out, background-color 120ms ease-out;
}

.scale-labels {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: space-between;
  color: var(--muted);
  font-size: 18rpx;
  font-family: Georgia, "Songti SC", serif;
}

.status-copy {
  margin-top: 20rpx;
  min-height: 78rpx;
  text-align: center;
  flex: 0 0 auto;
}

.action-tone {
  display: block;
  color: var(--warning);
  font-size: 26rpx;
  line-height: 1.25;
  font-weight: 700;
}

.action-tone.in-tune {
  color: var(--success);
}

.action-tone.sharp,
.action-tone.flat,
.action-tone.far {
  color: var(--accent);
}

.action-tone.waiting {
  color: var(--muted);
}

.status-line {
  display: block;
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 1.3;
}

.instrument-panel {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  min-height: 0;
  margin-top: 2rpx;
}

.violin-stage {
  position: relative;
  width: 64vw;
  max-width: 480rpx;
  min-height: 0;
  margin-bottom: -8rpx;
}

.violin-head {
  position: relative;
  z-index: 2;
  width: 100%;
  display: block;
  filter: drop-shadow(0 22rpx 28rpx rgba(23, 22, 20, 0.2));
}

.string-guideline {
  position: absolute;
  left: 50%;
  top: 18%;
  width: 4rpx;
  height: 67%;
  margin-left: -3rpx;
  opacity: 0;
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(146, 118, 74, 0) 0%, rgba(146, 118, 74, 0.86) 34%, rgba(146, 118, 74, 0.86) 72%, rgba(146, 118, 74, 0) 100%);
  box-shadow: 0 0 18rpx rgba(146, 118, 74, 0.38);
  transition: opacity 180ms ease-out;
  z-index: 3;
}

.string-guideline.active {
  opacity: 1;
}

.string-control {
  position: absolute;
  z-index: 4;
  width: 194rpx;
  height: 88rpx;
  box-sizing: border-box;
}

.string-control.left.top {
  left: -10%;
  top: 33%;
}

.string-control.left.bottom {
  left: -10%;
  top: 49.5%;
}

.string-control.right.top {
  right: -10%;
  top: 26.5%;
}

.string-control.right.bottom {
  right: -10%;
  top: 42.5%;
}

.string-control.active {
  transform: scale(1.02);
}

.string-label {
  position: absolute;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary);
  font-family: Georgia, "Songti SC", serif;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
  border-radius: 50%;
  box-sizing: border-box;
  transition:
    color 160ms ease-out,
    transform 160ms ease-out,
    border-color 160ms ease-out,
    background 160ms ease-out,
    box-shadow 160ms ease-out;
  z-index: 5;
}

.string-label.left.top,
.string-label.left.bottom {
  left: 8rpx;
  top: 8rpx;
}

.string-label.right.top,
.string-label.right.bottom {
  right: 8rpx;
  top: 8rpx;
}

.string-label.active {
  border: 2rpx solid rgba(146, 118, 74, 0.76);
  background: rgba(245, 239, 227, 0.78);
  color: var(--accent);
  box-shadow: 0 0 0 7rpx rgba(146, 118, 74, 0.1);
  transform: none;
}

.metrics-row {
  display: grid;
  grid-template-columns: 1fr 1.6fr 1fr;
  gap: 0;
  border-top: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
  flex: 0 0 auto;
}

.metric-chip {
  min-height: 72rpx;
  padding: 12rpx 8rpx 10rpx;
  border-right: 1rpx solid var(--line);
  text-align: center;
}

.metric-chip:last-child {
  border-right: none;
}

.metric-value {
  display: block;
  color: var(--primary);
  font-family: Georgia, "Songti SC", serif;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.2;
}

.metric-label {
  display: block;
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 18rpx;
  line-height: 1.2;
}

.string-indicator {
  position: absolute;
  z-index: 5;
  color: var(--muted);
  font-family: Georgia, "Songti SC", serif;
  font-size: 44rpx;
  font-weight: 300;
  line-height: 1;
  opacity: 0.48;
}

.string-indicator.left.top {
  left: 36rpx;
  top: 33%;
}

.string-indicator.left.bottom {
  left: 36rpx;
  top: 49.5%;
}

.string-indicator.right.top {
  right: 36rpx;
  top: 26.5%;
}

.string-indicator.right.bottom {
  right: 36rpx;
  top: 42.5%;
}

.reduce-motion .scale-needle,
.reduce-motion .toggle-dot,
.reduce-motion .string-guideline,
.reduce-motion .string-label,
.reduce-motion .string-control {
  transition: none !important;
}

.listening-button {
  width: 100%;
  max-width: 520rpx;
  margin: 14rpx auto 0;
  min-height: 68rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--primary);
  background: transparent;
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 68rpx;
}

.listening-button.active {
  background: var(--primary);
  color: var(--ivory);
}

@media (max-width: 375px) {
  .detect-page {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }

  .readout-note {
    font-size: 96rpx;
  }

  .violin-stage {
    width: 66vw;
    max-width: 450rpx;
  }

  .string-control {
    width: 170rpx;
    height: 78rpx;
  }

  .string-label {
    width: 62rpx;
    height: 62rpx;
    font-size: 34rpx;
  }
}
