.detect-page {
  min-height: 100vh;
  padding: 24rpx 34rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  background:
    radial-gradient(circle at 50% 18%, rgba(236, 156, 19, 0.16), transparent 30%),
    linear-gradient(180deg, #FBFAF3 0%, #F1EEE2 48%, #ECE7D8 100%);
  color: #12151B;
  overflow: hidden;
}

.tuner-header {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  min-height: 52rpx;
}

.screen-title {
  justify-self: center;
  padding-left: 90rpx;
  color: #111318;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.screen-close {
  color: #111318;
  font-size: 24rpx;
  line-height: 1;
}

.gauge-wrap {
  height: 286rpx;
  position: relative;
}

.gauge {
  position: relative;
  width: 680rpx;
  height: 286rpx;
  margin: 0 auto;
}

.gauge-image {
  position: absolute;
  left: 0;
  top: -12rpx;
  width: 680rpx;
  filter: drop-shadow(0 14rpx 18rpx rgba(72, 54, 20, 0.14));
  z-index: 1;
}

.gauge-needle {
  position: absolute;
  left: 50%;
  top: 82rpx;
  width: 22rpx;
  margin-left: -11rpx;
  transform-origin: 50% 100%;
  transition: transform 120ms ease-out;
  z-index: 4;
}

.frequency-row {
  margin-top: -28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  color: #2E332F;
  font-size: 24rpx;
}

.listen-dot {
  width: 48rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: #D8D5CA;
  position: relative;
}

.listen-dot::after {
  content: "";
  position: absolute;
  left: 6rpx;
  top: 6rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #F8F5EA;
  transition: transform 160ms ease-out;
}

.listen-dot.active {
  background: #EC9C13;
}

.listen-dot.active::after {
  transform: translateX(20rpx);
}

.status-copy {
  min-height: 76rpx;
  text-align: center;
}

.action-tone {
  display: block;
  color: #115E73;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.25;
}

.action-tone.in-tune {
  color: #1B7F45;
}

.action-tone.sharp,
.action-tone.flat {
  color: #0E6E83;
}

.action-tone.far {
  color: #C33A24;
}

.action-tone.waiting {
  color: #6C6B60;
}

.status-line {
  display: block;
  margin-top: 8rpx;
  color: rgba(18, 21, 27, 0.62);
  font-size: 22rpx;
}

.instrument-panel {
  position: relative;
  flex: 1;
  min-height: 500rpx;
}

.violin-stage {
  position: relative;
  width: 100%;
  height: 536rpx;
}

.violin-head {
  position: absolute;
  left: 50%;
  top: 0;
  width: 386rpx;
  transform: translateX(-50%);
  transform-origin: center center;
  filter: drop-shadow(0 18rpx 26rpx rgba(35, 19, 8, 0.32));
  z-index: 2;
}

.fingerboard-light {
  position: absolute;
  left: 50%;
  top: 170rpx;
  width: 70rpx;
  height: 344rpx;
  transform: translateX(-50%);
  border-radius: 50rpx;
  background: linear-gradient(180deg, rgba(28, 129, 189, 0.12), rgba(38, 177, 255, 0.72), rgba(28, 129, 189, 0.08));
  filter: blur(2rpx);
  box-shadow: 0 0 40rpx rgba(33, 162, 255, 0.8);
  z-index: 1;
}

.string-selectors {
  position: absolute;
  top: 166rpx;
  display: flex;
  flex-direction: column;
  gap: 52rpx;
  z-index: 4;
}

.string-selectors-left {
  left: 20rpx;
  align-items: flex-start;
}

.string-selectors-right {
  right: 20rpx;
  align-items: flex-end;
}

.string-control {
  min-width: 142rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.string-selectors-right .string-control {
  flex-direction: row-reverse;
}

.string-button {
  width: 76rpx;
  height: 76rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: transparent;
  color: #151515;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 76rpx;
  text-align: center;
}

.string-button::after {
  border: 0;
}

.string-button.active {
  color: #F9F5E9;
  background: rgba(136, 71, 28, 0.88);
  box-shadow:
    0 0 0 10rpx rgba(42, 164, 255, 0.28),
    0 0 34rpx rgba(42, 164, 255, 0.95),
    inset 0 4rpx 10rpx rgba(255, 255, 255, 0.26);
}

.string-name {
  color: rgba(18, 21, 27, 0.55);
  font-size: 20rpx;
}

.readout-strip {
  display: grid;
  grid-template-columns: 1fr 1.7fr 1fr;
  gap: 10rpx;
  padding: 18rpx 0 0;
}

.readout-item {
  min-height: 84rpx;
  border-top: 2rpx solid rgba(70, 58, 38, 0.18);
  padding-top: 12rpx;
  text-align: center;
}

.readout-value {
  display: block;
  color: #171717;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.2;
}

.readout-label {
  display: block;
  margin-top: 8rpx;
  color: rgba(18, 21, 27, 0.54);
  font-size: 20rpx;
  line-height: 1.2;
}

.actions {
  padding-top: 4rpx;
}

.primary-button {
  min-height: 88rpx;
  border-radius: 8rpx;
  background: #EC9C13;
  color: #111318;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 88rpx;
}

.recording {
  background: #171717;
  color: #F7F1E5;
}

@media (max-width: 360px) {
  .detect-page {
    padding-left: 24rpx;
    padding-right: 24rpx;
  }

  .gauge {
    width: 640rpx;
  }

  .violin-stage {
    height: 520rpx;
  }

  .string-selectors-left {
    left: 14rpx;
  }

  .string-selectors-right {
    right: 14rpx;
  }
}
