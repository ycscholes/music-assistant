.score-list-page,
.header,
.piece-list,
.piece-card,
.piece-facts,
.piece-link-row {
  display: flex;
}

.score-list-page {
  flex-direction: column;
  gap: 32rpx;
}

.score-list-page {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.header {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid rgba(23, 22, 20, 0.18);
}

.piece-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.piece-card {
  flex-direction: column;
  gap: 12rpx;
}

.eyebrow {
  color: var(--warning);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.title {
  color: var(--primary);
  font-family: "Songti SC", "STSong", Georgia, serif;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.08;
}

.subtitle,
.piece-meta,
.piece-focus,
.piece-facts {
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.45;
}

.piece-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.piece-card {
  padding: 28rpx 26rpx 24rpx;
  border: 1rpx solid rgba(216, 208, 192, 0.9);
  border-left: 6rpx solid rgba(154, 77, 56, 0.72);
  background: rgba(245, 239, 227, 0.62);
}

.piece-title,
.piece-duration {
  display: block;
  color: var(--primary);
  font-family: "Songti SC", "STSong", Georgia, serif;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1;
}

.piece-meta,
.piece-focus {
  display: block;
}

.piece-action {
  display: flex;
  flex-shrink: 0;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  padding-top: 4rpx;
}

.piece-unit {
  color: var(--warning);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.piece-facts {
  gap: 10rpx;
  flex-wrap: wrap;
}

.piece-facts text {
  padding: 5rpx 14rpx;
  border: 1rpx solid rgba(23, 22, 20, 0.14);
  border-radius: 999rpx;
  background: rgba(251, 250, 244, 0.7);
}

.piece-link {
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 800;
}

.piece-link-row {
  justify-content: flex-end;
  padding-top: 4rpx;
}

.piece-card-active {
  background: rgba(245, 239, 227, 0.92);
}
