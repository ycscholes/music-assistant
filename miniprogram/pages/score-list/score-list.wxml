<view class="page score-list-page">
  <view class="header">
    <text class="eyebrow">Score Practice</text>
    <text class="title">曲谱评测</text>
    <text class="subtitle">选择曲目后直接进入谱面练习，支持固定节拍、跟随模式与音准闯关。</text>
  </view>

  <view class="piece-list">
    <view wx:for="{{pieces}}" wx:key="id" class="panel piece-card" hover-class="piece-card-active" data-id="{{item.id}}" bindtap="openPiece">
      <view class="piece-head">
        <view>
          <text class="piece-title">{{item.title}}</text>
          <text class="piece-meta">{{item.difficulty}} · {{item.keySignature}} · {{item.timeSignature}}</text>
        </view>
        <view class="piece-action">
          <text class="piece-duration">{{item.bpm}}</text>
          <text class="piece-unit">BPM</text>
        </view>
      </view>
      <view class="piece-facts">
        <text>{{item.noteCount}} 个音</text>
        <text>{{item.estimatedDurationSec}}s</text>
        <text>{{item.difficulty}}</text>
      </view>
      <text class="piece-focus">{{item.focusText}}</text>
      <view class="piece-link-row">
        <text class="piece-link">开始练习</text>
      </view>
    </view>
  </view>
</view>
