page {
  --primary: #171614;
  --accent: #9A4D38;
  --success: #5E6F4E;
  --warning: #92764A;
  --danger: #B85042;
  --ink: #171614;
  --muted: #756D61;
  --line: #D8D0C0;
  --surface: #F5EFE3;
  --background: #FBFAF4;
  --ivory: #F5EFE3;
  --staff-gray: #8B949E;

  background: var(--background);
  color: var(--ink);
  font-family: "PingFang SC", "Songti SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view,
text,
button {
  box-sizing: border-box;
}

button::after {
  border: none;
}

.page {
  min-height: 100vh;
  padding: 40rpx 32rpx;
  background:
    linear-gradient(90deg, rgba(216, 208, 192, 0.26) 0 1rpx, transparent 1rpx 100%),
    linear-gradient(180deg, #FBFAF4 0%, #F7F1E8 100%);
  background-size: 100% 100%, 100% 100%;
}

.panel {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 0;
  padding: 28rpx;
}

.primary-button {
  width: 100%;
  max-width: 520rpx;
  min-height: 72rpx;
  margin-left: auto;
  margin-right: auto;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: var(--ivory);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 72rpx;
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.primary-button-hover {
  opacity: 0.88;
  transform: scale(0.985);
}

.secondary-button {
  width: 100%;
  max-width: 520rpx;
  min-height: 68rpx;
  margin-left: auto;
  margin-right: auto;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--ivory);
  color: var(--primary);
  border: 1.5rpx solid rgba(23, 22, 20, 0.24);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 68rpx;
  transition: background 0.15s ease, transform 0.15s ease;
}

.secondary-button-hover {
  background: var(--surface);
  transform: scale(0.985);
}

.muted {
  color: var(--muted);
}

.paper-rule {
  height: 1rpx;
  background: var(--line);
}

.quiet-link {
  color: var(--primary);
  font-size: 28rpx;
  font-weight: 700;
}

.meta-label {
  color: var(--muted);
  font-size: 20rpx;
  line-height: 1.3;
}

.serif {
  font-family: "Songti SC", "STSong", Georgia, serif;
}

.reduce-motion .toggle-dot,
.reduce-motion .scale-needle,
.reduce-motion .string-guideline,
.reduce-motion .string-label,
.reduce-motion .string-control,
.reduce-motion .beat-pill {
  transition: none !important;
  animation: none !important;
}
